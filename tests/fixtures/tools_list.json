          "type": "string",
          "description": "Fresh range handle returned by a code_retrieve read. It binds the workspace, path, line range, and content hash. A handle-based change must be the only change for its file in one transaction; combining it with another change for that file is rejected as ambiguous."
        },
        "new_text": {
          "type": "string",
          "description": "Replacement text. When replacing text that ends with a terminal newline, omitting that newline here preserves it from the selected text or range."
